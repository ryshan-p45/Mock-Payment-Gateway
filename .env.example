# Credentials for the default seeded test merchant.
# Leave unset to use the built-in defaults (SiteCode=TESTSITE01), or override
# so a deployed instance ships with credentials only your team knows.
SEED_SITE_CODE=TESTSITE01
SEED_PRIVATE_KEY=TestPrivateKey12345
SEED_API_KEY=TestApiKey12345

# Railway sets PORT automatically; only needed for local overrides.
# PORT=3000
